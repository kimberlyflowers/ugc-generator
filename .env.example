# Vercel Blob Storage
# Get this from: https://vercel.com/docs/storage/vercel-blob/quickstart
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# ComfyUI Backend
# Your ComfyUI instance URL (RunPod/Vast.ai/Local)
COMFYUI_API_URL=http://your-comfyui-instance:8188

# Replicate (for LoRA training)
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_USERNAME=your-replicate-username

# ElevenLabs (for voice generation & lip sync)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_sarah_voice_id

# Optional: HeyGen (if using as fallback)
HEYGEN_API_KEY=your_heygen_api_key_here

# Optional: RunPod Configuration
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_TEMPLATE_ID=your_comfyui_template_id
